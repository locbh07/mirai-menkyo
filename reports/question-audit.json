      ],
      "examIds": [
        "karimen-7",
        "karimen-9"
      ],
      "types": [
        "karimen"
      ],
      "text": "Trừ xe máy, chủ xe phải đảm bảo nơi lưu giữ xe trong vòng 5 km từ nơi sử dụng chính."
    },
    {
      "questionIds": [
        "karimen-7-38",
        "karimen-15-18"
      ],
      "examIds": [
        "karimen-7",
        "karimen-15"
      ],
      "types": [
        "karimen"
      ],
      "text": "Trên các con dốc xuống dốc, phương tiện phải di chuyển chậm."
    },
    {
      "questionIds": [
        "karimen-9-34",
        "karimen-10-45"
      ],
      "examIds": [
        "karimen-9",
        "karimen-10"
      ],
      "types": [
        "karimen"
      ],
      "text": "Khi tiếp cận vạch qua đường và rõ ràng không có người đi bộ, bạn có thể đi tiếp mà không dừng."
    },
    {
      "questionIds": [
        "karimen-14-50",
        "karimen-15-1"
      ],
      "examIds": [
        "karimen-14",
        "karimen-15"
      ],
      "types": [
        "karimen"
      ],
      "text": "Không có giới hạn thời gian cho việc dừng xe để đón hoặc trả khách."
    },
    {
      "questionIds": [
        "honmen-1-8",
        "gentsuki-1-4"
      ],
      "examIds": [
        "honmen-1",
        "gentsuki-1"
      ],
      "types": [
        "honmen",
        "gentsuki"
      ],
      "text": "Trên đường dốc xuống, việc tăng tốc độ khiến khoảng cách dừng trở nên dài hơn, vì vậy người lái xe nên giữ khoảng cách giữa các xe dài hơn so với khi đi trên mặt đường bằng phẳng."
    },
    {
      "questionIds": [
        "honmen-2-79",
        "honmen-2-89"
      ],
      "examIds": [
        "honmen-2"
      ],
      "types": [
        "honmen"
      ],
      "text": "Khi lái xe hai bánh vào mùa hè, người lái xe nên mặc trang phục thoáng mát như áo sơ mi ngắn tay và quần short."
    },
    {
      "questionIds": [
        "gentsuki-2-19",
        "gentsuki-4-22"
      ],
      "examIds": [
        "gentsuki-2",
        "gentsuki-4"
      ],
      "types": [
        "gentsuki"
      ],
      "text": "Trên đường không có làn xe, bạn có thể đi bất kỳ đâu ở phía bên trái của vạch giữa."
    },
    {
      "questionIds": [
        "gentsuki-2-38",
        "gentsuki-3-26"
      ],
      "examIds": [
        "gentsuki-2",
        "gentsuki-3"
      ],
      "types": [
        "gentsuki"
      ],
      "text": "Trên đường có biển báo này, vì số làn đường giảm, bạn phải đi ở làn bên phải."
    }
  ],
